# Test Gap Finder environment configuration
#
# Copy this file to `.env` for local development:
#
#     Copy-Item .env.example .env
#
# Never commit your real `.env` file.

# ------------------------------------------------------------
# Google Gemini
# ------------------------------------------------------------
#
# Gemini is optional.
# If no valid key is supplied, Test Gap Finder falls back to
# its deterministic test planner.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override.
# Set this only when you want to explicitly choose a Gemini
# model available to your account.
#
# Example:
#
# GEMINI_MODEL=your_available_gemini_model