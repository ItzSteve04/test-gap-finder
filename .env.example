
# ---------------------------------------------------------------------------
# Gemini AI provider (optional)
# ---------------------------------------------------------------------------
# When GEMINI_API_KEY is set, the Gemini provider is selected automatically.
# Leave both variables unset to use the built-in DeterministicPlanner instead.

# Your Google Gemini Developer API key (required to enable Gemini)
GEMINI_API_KEY=

# Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
